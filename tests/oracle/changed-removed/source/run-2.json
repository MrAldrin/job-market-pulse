    [
      "table",
      "ad_occupation_checks",
      "ad_occupation_checks",
      "CREATE TABLE ad_occupation_checks (\n            uuid TEXT PRIMARY KEY, saved_changed TEXT NOT NULL,\n            category_count INTEGER NOT NULL\n        )"
    ],
    [
      "table",
      "ad_occupations",
      "ad_occupations",
      "CREATE TABLE ad_occupations (\n            uuid TEXT NOT NULL, scheme TEXT NOT NULL,\n            level1 TEXT NOT NULL, level2 TEXT NOT NULL,\n            code TEXT NOT NULL, name TEXT NOT NULL,\n            PRIMARY KEY (uuid, scheme, level1, level2, code, name)\n        )"
    ],
    [
      "table",
      "ad_salaries",
      "ad_salaries",
      "CREATE TABLE ad_salaries (\n        uuid TEXT PRIMARY KEY, form TEXT\n            CHECK(form IS NULL OR form IN ('range','single','vague','max')),\n        min_nok REAL, max_nok REAL,\n        period TEXT CHECK(period IS NULL OR period IN ('year','month','hour')),\n        sko_code TEXT, ltr_min INTEGER, ltr_max INTEGER,\n        detail_changed TEXT NOT NULL,\n        period_inferred INTEGER NOT NULL DEFAULT 0,\n        amount_unclear INTEGER NOT NULL DEFAULT 0\n    )"
    ],
    [
      "table",
      "ad_status_evidence",
      "ad_status_evidence",
      "CREATE TABLE ad_status_evidence (\n            uuid TEXT PRIMARY KEY, changed TEXT NOT NULL, status TEXT NOT NULL\n                CHECK(status IN ('ACTIVE','INACTIVE','STOPPED','DELETED'))\n        )"
    ],
    [
      "table",
      "ad_texts",
      "ad_texts",
      "CREATE TABLE ad_texts (\n            uuid TEXT PRIMARY KEY, text TEXT NOT NULL, detail_changed TEXT NOT NULL,\n            closed_at TEXT\n        )"
    ],
    [
      "table",
      "ads",
      "ads",
      "CREATE TABLE ads (\n            uuid TEXT PRIMARY KEY, changed TEXT NOT NULL,\n            first_seen TEXT NOT NULL, observed TEXT NOT NULL,\n            title TEXT NOT NULL, employer TEXT NOT NULL, locations TEXT NOT NULL,\n            topics TEXT NOT NULL, detail_missing INTEGER NOT NULL,\n            expires TEXT, source TEXT\n        )"
    ],
    [
      "table",
      "events",
      "events",
      "CREATE TABLE events (id TEXT PRIMARY KEY)"
    ],
    [
      "table",
      "pages",
      "pages",
      "CREATE TABLE pages (\n            url TEXT PRIMARY KEY, etag TEXT, modified TEXT\n        )"
    ],
    [
      "table",
      "state",
      "state",
      "CREATE TABLE state (key TEXT PRIMARY KEY, value TEXT NOT NULL)"
    ],
    [
      "table",
      "versions",
      "versions",
      "CREATE TABLE versions (uuid TEXT PRIMARY KEY, changed TEXT NOT NULL)"
    ],
    [
      "trigger",
      "ads_detail_version_cleanup",
      "ads",
      "CREATE TRIGGER ads_detail_version_cleanup\n        AFTER DELETE ON ads\n        BEGIN\n            DELETE FROM ad_detail_versions WHERE uuid = OLD.uuid;\n        END"
    ],
    [
      "trigger",
      "ads_location_cleanup",
      "ads",
      "CREATE TRIGGER ads_location_cleanup\n        AFTER DELETE ON ads\n        BEGIN DELETE FROM ad_locations WHERE uuid=OLD.uuid; END"
    ],
    [
      "trigger",
      "ads_occupation_cleanup",
      "ads",
      "CREATE TRIGGER ads_occupation_cleanup\n        AFTER DELETE ON ads\n        BEGIN\n            DELETE FROM ad_occupations WHERE uuid = OLD.uuid;\n            DELETE FROM ad_occupation_checks WHERE uuid = OLD.uuid;\n        END"
    ],
    [
      "trigger",
      "ads_text_cleanup",
      "ads",
      "CREATE TRIGGER ads_text_cleanup\n        AFTER DELETE ON ads\n        BEGIN\n            DELETE FROM ad_texts WHERE uuid = OLD.uuid AND closed_at IS NULL;\n        END"
    ]
  ],
