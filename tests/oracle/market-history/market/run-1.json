      "table",
      "counts",
      "counts",
      "CREATE TABLE counts (\n    snapshot_id INTEGER NOT NULL REFERENCES snapshots(id),\n    kind TEXT NOT NULL CHECK (kind IN ('family', 'term')),\n    key TEXT NOT NULL,\n    count INTEGER NOT NULL,\n    PRIMARY KEY (snapshot_id, kind, key)\n)"
    ],
    [
      "table",
      "snapshots",
      "snapshots",
      "CREATE TABLE snapshots (\n    id INTEGER PRIMARY KEY,\n    label TEXT NOT NULL UNIQUE,\n    period_start TEXT,\n    period_end TEXT,\n    source TEXT NOT NULL,\n    sampled INTEGER NOT NULL,\n    ad_count INTEGER NOT NULL,\n    taxonomy_version TEXT NOT NULL,\n    created_at TEXT NOT NULL,\n    basis TEXT NOT NULL DEFAULT 'titles' CHECK (basis IN ('titles', 'titles+text'))\n)"
    ],
    [
      "table",
      "tech_term_counts",
      "tech_term_counts",
      "CREATE TABLE tech_term_counts (\n    snapshot_id INTEGER NOT NULL REFERENCES snapshots(id),\n    key TEXT NOT NULL,\n    count INTEGER NOT NULL,\n    PRIMARY KEY (snapshot_id, key)\n)"
    ],
    [
      "table",
      "unknown_title_word_counts",
      "unknown_title_word_counts",
      "CREATE TABLE unknown_title_word_counts (\n    snapshot_id INTEGER NOT NULL REFERENCES snapshots(id),\n    word TEXT NOT NULL,\n    count INTEGER NOT NULL,\n    PRIMARY KEY (snapshot_id, word)\n)"
    ],
    [
      "table",
      "unknown_title_word_snapshots",
      "unknown_title_word_snapshots",
      "CREATE TABLE unknown_title_word_snapshots (\n    snapshot_id INTEGER PRIMARY KEY REFERENCES snapshots(id),\n    complete INTEGER NOT NULL CHECK (complete IN (0, 1))\n)"
    ]
  ],
