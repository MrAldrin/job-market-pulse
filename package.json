{
  "name": "job-market-pulse",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "bin": {
    "pulse": "./src/cli/pulse.ts"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "bun --bun vite --host 127.0.0.1",
    "desktop": "bun --no-env-file src/cli/pulse.ts desktop",
    "setup": "bun --no-env-file src/cli/setup-checkout.ts",
    "setup:desktop": "bun node_modules/electron/install.js",
    "package:linux": "sh scripts/package-linux.sh",
    "package:windows": "sh scripts/package-windows.sh",
    "build": "bun --bun vite build",
    "icons": "PLAYWRIGHT_BROWSERS_PATH=local_only/playwright-browsers bun scripts/render-icons.ts",
    "types": "svelte-kit sync && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts",
    "lint": "oxlint",
    "test:fast": "bun --bun vitest run",
    "test:legacy-harness": "bun test ./tests/pi_review_bridge.test.ts ./tests/pi_review_provider_serialization.test.ts",
    "test:oracle": "bun tests/oracle/run.ts",
    "test:desktop-shutdown": "bun run build && playwright test --config playwright.desktop.config.ts dashboard-shutdown.spec.ts",
    "test:desktop": "bun run build && playwright test --config playwright.desktop.config.ts dashboard.spec.ts",
    "test:appimage": "PULSE_APPIMAGE_SMOKE=1 playwright test --config playwright.desktop.config.ts appimage.spec.ts",
    "test:smoke": "bash scripts/test-smoke.sh",
    "test:slow": "PLAYWRIGHT_BROWSERS_PATH=local_only/playwright-browsers playwright test",
    "setup:browser": "PLAYWRIGHT_BROWSERS_PATH=local_only/playwright-browsers playwright install chromium --only-shell",
    "spike:sqlite": "bun tests/sqlite/spike.ts",
    "check": "bun run types && bun run lint && bun run test:fast && bun run test:oracle && bun run test:legacy-harness"
  },
  "dependencies": {
    "@effect/cli": "0.77.2",
    "@effect/experimental": "0.61.2",
    "@effect/platform": "0.97.3",
    "@effect/platform-bun": "0.91.4",
    "@effect/sql": "0.52.2",
    "@effect/sql-sqlite-bun": "0.53.1",
    "@xmldom/xmldom": "0.9.12",
    "effect": "3.22.4",
    "layerchart": "2.11.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/adapter-bun": "1.0.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "vite": "8.3.8",
    "typescript": "6.0.3",
    "tailwindcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "vitest": "5.1.0",
    "fast-check": "4.10.2",
    "@playwright/test": "1.65.1",
    "oxlint": "1.94.0",
    "@oxlint/plugins": "1.94.0",
    "@types/bun": "1.4.4",
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
