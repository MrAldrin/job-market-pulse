[Unit]
Description=Job Market Pulse scheduled run

[Service]
Type=oneshot
WorkingDirectory="/tmp/pulse-port-oracle/basic-run/installation"
UMask=0077
TimeoutStartSec=3600
ExecStart="/synthetic/bin/uv" "run" "--project" "/tmp/pulse-port-oracle/basic-run/installation" "python" "-m" "pulse.cli.pulse" "--profile" "invented" "run-scheduled"
